{
    "OS": [
        {
            "q_id": "q_e946102b-d065-48ae-92a4-ceab664da91c",
            "text": "What is the primary function of an Operating System?",
            "options": [
                "Manage computer hardware",
                "Provide a user interface",
                "Execute application programs",
                "All of the above"
            ],
            "correct_answer": "All of the above",
            "marks": 1
        },
        {
            "q_id": "q_4c36595a-0d81-47ef-9afb-27b60db7ca78",
            "text": "Which scheduling algorithm aims to minimize the average waiting time?",
            "options": [
                "First-Come, First-Served (FCFS)",
                "Shortest Job First (SJF)",
                "Round Robin (RR)",
                "Priority Scheduling"
            ],
            "correct_answer": "Shortest Job First (SJF)",
            "marks": 2
        },
        {
            "q_id": "q_cd9c0863-74e5-4c0b-b3c8-d7389352b905",
            "text": "A process currently waiting for the CPU to become available is in which state?",
            "options": [
                "Running",
                "Waiting",
                "Ready",
                "Terminated"
            ],
            "correct_answer": "Ready",
            "marks": 1
        },
        {
            "q_id": "q_b9568a95-c37f-4c2e-bcbb-0407d3ef9b39",
            "text": "The mechanism where the OS uses secondary storage to extend the available RAM is called:",
            "options": [
                "Caching",
                "Spooling",
                "Virtual Memory",
                "Buffering"
            ],
            "correct_answer": "Virtual Memory",
            "marks": 1
        },
        {
            "q_id": "q_7714fd0e-81bf-4c0c-9b8f-ef28b2e1f734",
            "text": "A situation where two or more processes are waiting indefinitely for an event that can only be caused by one of the waiting processes is called:",
            "options": [
                "Starvation",
                "Deadlock",
                "Race Condition",
                "Critical Section"
            ],
            "correct_answer": "Deadlock",
            "marks": 2
        },
        {
            "q_id": "q_7194de29-bed2-43f7-b8e8-62c957d7ad9f",
            "text": "What is \"Thrashing\" in the context of memory management?",
            "options": [
                "Excessive page swapping",
                "Memory leak",
                "Buffer overflow",
                "Disk fragmentation"
            ],
            "correct_answer": "Excessive page swapping",
            "marks": 1
        },
        {
            "q_id": "q_33cb7547-2957-41e3-a069-b43b1e86233d",
            "text": "A semaphore is used primarily for:",
            "options": [
                "Memory allocation",
                "Process synchronization",
                "File management",
                "CPU scheduling"
            ],
            "correct_answer": "Process synchronization",
            "marks": 2
        },
